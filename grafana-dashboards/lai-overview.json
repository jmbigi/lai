{
  "dashboard": {
    "title": "LAI Overview",
    "tags": ["lai", "overview"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Tasks Completed",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "increase(lai_tasks_completed_total[5m])",
            "legendFormat": "Tasks/5m"
          }
        ],
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}
      },
      {
        "id": 2,
        "title": "Verification Rate",
        "type": "gauge",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "lai_verification_rate * 100",
            "legendFormat": "Verified %"
          }
        ],
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}
      },
      {
        "id": 3,
        "title": "Avg Latency (ms)",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "lai_avg_latency_ms",
            "legendFormat": "Avg Latency"
          }
        ],
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}
      },
      {
        "id": 4,
        "title": "Tool Calls",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(lai_tool_calls_total[5m])",
            "legendFormat": "{{tool}}"
          }
        ],
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}
      },
      {
        "id": 5,
        "title": "Token Usage",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(lai_tokens_input_total[5m])",
            "legendFormat": "Input Tokens"
          },
          {
            "expr": "rate(lai_tokens_output_total[5m])",
            "legendFormat": "Output Tokens"
          }
        ],
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}
      },
      {
        "id": 6,
        "title": "Error Rate",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(lai_errors_total[5m])",
            "legendFormat": "{{error_type}}"
          }
        ],
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}
      },
      {
        "id": 7,
        "title": "Memory Usage (MB)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "lai_memory_usage_mb",
            "legendFormat": "Memory"
          }
        ],
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}
      },
      {
        "id": 8,
        "title": "Benchmark Results",
        "type": "table",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "lai_benchmark_success_rate",
            "legendFormat": "{{capability}}",
            "format": "table"
          }
        ],
        "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s"
  }
}