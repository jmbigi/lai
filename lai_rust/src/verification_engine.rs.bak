//! VerificationEngine - Motor de verificación multi-nivel para código.
//! Implementa verificación en múltiples niveles: sintaxis, tipos, tests, lint, seguridad.

use anyhow::{Context, Result};
use serde::{Deserialize, Serialize};
use std::collections::HashMap;
use std::path::{Path, PathBuf};
use std::process::{Command, Stdio};
use std::time::Instant;

/// Nivel de verificación
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
pub enum VerificationLevel {
    Syntax = 1,
    Format = 2,
    Lint = 3,
    Types = 4,
    UnitTests = 5,
    IntegrationTests = 6,
    Security = 7,
    Performance = 8,
}

impl VerificationLevel {
    pub fn name(&self) -> &'static str {
        match self {
            VerificationLevel::Syntax => "Syntax",
            VerificationLevel::Format => "Format",
            VerificationLevel::Lint => "Lint",
            VerificationLevel::Types => "Types",
            VerificationLevel::UnitTests => "UnitTests",
            VerificationLevel::IntegrationTests => "IntegrationTests",
            VerificationLevel::Security => "Security",
            VerificationLevel::Performance => "Performance",
        }
    }

    pub fn all() -> Vec<VerificationLevel> {
        vec![
            VerificationLevel::Syntax,
            VerificationLevel::Format,
            VerificationLevel::Lint,
            VerificationLevel::Types,
            VerificationLevel::UnitTests,
            VerificationLevel::IntegrationTests,
            VerificationLevel::Security,
            VerificationLevel::Performance,
        ]
    }
}

/// Resultado de una verificación individual
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct VerificationResult {
    pub level: VerificationLevel,
    pub passed: bool,
    pub score: f64,
    pub details: String,
    pub duration_ms: u64,
    pub artifacts: Vec<String>,
}

/// Resultado completo de verificación
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct VerificationReport {
    pub target: String,
    pub levels_run: Vec<VerificationLevel>,
    pub results: Vec<VerificationResult>,
    pub overall_passed: bool,
    pub overall_score: f64,
    pub total_duration_ms: u64,
    pub baseline_comparison: Option<BaselineComparison>,
}

/// Comparación con baseline
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct BaselineComparison {
    pub previous_score: f64,
    pub current_score: f64,
    pub regression: bool,
    pub improvements: Vec<String>,
    pub regressions: Vec<String>,
}

/// Configuración del motor de verificación
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct VerificationConfig {
    pub levels: Vec<VerificationLevel>,
    pub min_score: f64,
    pub timeout_secs: u64,
    pub parallel: bool,
    pub fail_fast: bool,
    pub baseline_file: Option<PathBuf>,
    pub output_dir: Option<PathBuf>,
}

impl Default for VerificationConfig {
    fn default() -> Self {
        Self {
            levels: VerificationLevel::all(),
            min_score: 85.0,
            timeout_secs: 300,
            parallel: false,
            fail_fast: false,
            baseline_file: None,
            output_dir: None,
        }
    }
}

/// Motor de verificación multi-nivel
pub struct VerificationEngine {
    config: VerificationConfig,
    workspace_root: PathBuf,
    baseline: Option<VerificationReport>,
}

impl VerificationEngine {
    pub fn new(workspace_root: PathBuf, config: VerificationConfig) -> Result<Self> {
        let baseline = if let Some(path) = &config.baseline_file {
            if path.exists() {
                let content = std::fs::read_to_string(path)?;
                Some(serde_json::from_str(&content)?)
            } else {
                None
            } else {
                None
            };

        Ok(Self {
            config,
            workspace_root,
            baseline,
        })
    }

    /// Ejecutar verificación completa
    pub async fn verify(&self, target: &Path) -> Result<VerificationReport> {
        let start = Instant::now();
        let mut results = Vec::new();
        let mut levels_run = Vec::new();

        for level in &self.config.levels {
            levels_run.push(*level);
            let level_start = Instant::now();

            let result = match level {
                VerificationLevel::Syntax => self.verify_syntax(target).await?,
                VerificationLevel::Format => self.verify_format(target).await?,
                VerificationLevel::Lint => self.verify_lint(target).await?,
                VerificationLevel::Types => self.verify_types(target).await?,
                VerificationLevel::UnitTests => self.verify_unit_tests(target).await?,
                VerificationLevel::IntegrationTests => self.verify_integration_tests(target).await?,
                VerificationLevel::Security => self.verify_security(target).await?,
                VerificationLevel::Performance => self.verify_performance(target).await?,
            };

            let mut result = result;
            result.duration_ms = level_start.elapsed().as_millis() as u64;
            results.push(result);

            if self.config.fail_fast && !result.passed {
                break;
            }
        }

        let overall_passed = results.iter().all(|r| r.passed);
        let overall_score = if !results.is_empty() {
            results.iter().map(|r| r.score).sum::<f64>() / results.len() as f64
        } else {
            0.0
        };

        let mut report = VerificationReport {
            target: target.display().to_string(),
            levels_run,
            results,
            overall_passed,
            overall_score,
            total_duration_ms: start.elapsed().as_millis() as u64,
            baseline_comparison: None,
        };

        // Comparar con baseline si existe
        if let Some(baseline) = &self.baseline {
            report.baseline_comparison = Some(self.compare_with_baseline(baseline, &report));
        }

        // Guardar como nuevo baseline si hay directorio de salida
        if let Some(output_dir) = &self.config.output_dir {
            std::fs::create_dir_all(output_dir)?;
            let path = output_dir.join(format!("baseline_{}.json", chrono::Utc::now().timestamp()));
            std::fs::write(path, serde_json::to_string_pretty(&report)?)?;
        }

        Ok(report)
    }

    /// Verificar sintaxis
    async fn verify_syntax(&self, target: &Path) -> Result<VerificationResult> {
        let start = Instant::now();
        let mut checks = Vec::new();

        if target.is_file() {
            let content = std::fs::read_to_string(target)?;
            let ext = target.extension().and_then(|e| e.to_str()).unwrap_or("");

            let passed = match ext {
                "py" => self.check_python_syntax(&content),
                "rs" => self.check_rust_syntax(&content),
                "js" | "ts" | "jsx" | "tsx" => self.check_js_ts_syntax(&content),
                "go" => self.check_go_syntax(&content),
                _ => true, // Sin verificación para otros
            };

            checks.push(("syntax", passed, if passed { "Syntax OK" } else { "Syntax error" }.to_string()));
        } else {
            // Verificar todos los archivos del directorio
            let mut all_passed = true;
            for entry in walkdir::WalkDir::new(target).into_iter().filter_map(|e| e.ok()) {
                let path = entry.path();
                if path.is_file() {
                    if let Some(ext) = path.extension().and_then(|e| e.to_str()) {
                        if matches!(ext, "py" | "rs" | "js" | "ts" | "jsx" | "tsx" | "go") {
                            if let Ok(content) = std::fs::read_to_string(path) {
                                let passed = match ext {
                                    "py" => self.check_python_syntax(&content),
                                    "rs" => self.check_rust_syntax(&content),
                                    "js" | "ts" | "jsx" | "tsx" => self.check_js_ts_syntax(&content),
                                    "go" => self.check_go_syntax(&content),
                                    _ => true,
                                };
                                if !passed {
                                    all_passed = false;
                                }
                            }
                        }
                    }
                }
            }
            checks.push(("syntax", all_passed, if all_passed { "All syntax OK" } else { "Syntax errors found" }.to_string()));
        }

        let passed = checks.iter().all(|(_, p, _)| *p);
        let score = if checks.is_empty() { 100.0 } else {
            (checks.iter().filter(|(_, p, _)| *p).count() as f64 / checks.len() as f64) * 100.0
        };

        Ok(VerificationResult {
            level: VerificationLevel::Syntax,
            passed,
            score,
            details: checks.iter().map(|(_, _, d)| d).collect::<Vec<_>>().join("; "),
            duration_ms: start.elapsed().as_millis() as u64,
            artifacts: Vec::new(),
        })
    }

    fn check_python_syntax(&self, code: &str) -> bool {
        Command::new("python3")
            .arg("-c")
            .arg(format!("import ast; ast.parse({:?})", code))
            .stdout(Stdio::null())
            .stderr(Stdio::null())
            .status()
            .map(|s| s.success())
            .unwrap_or(false)
    }

    fn check_rust_syntax(&self, code: &str) -> bool {
        use std::io::Write;
        let mut file = tempfile::NamedTempFile::new().ok();
        if let Some(mut f) = file {
            if f.write_all(code.as_bytes()).is_ok() {
                return Command::new("rustc")
                    .arg("--emit=metadata")
                    .arg("-o")
                    .arg("/dev/null")
                    .arg(f.path())
                    .stdout(Stdio::null())
                    .stderr(Stdio::null())
                    .status()
                    .map(|s| s.success())
                    .unwrap_or(false);
            }
        }
        false
    }

    fn check_js_ts_syntax(&self, code: &str) -> bool {
        // Usar node --check si está disponible
        Command::new("node")
            .arg("--check")
            .arg("-e")
            .arg(code)
            .stdout(Stdio::null())
            .stderr(Stdio::null())
            .status()
            .map(|s| s.success())
            .unwrap_or(false)
    }

    fn check_go_syntax(&self, code: &str) -> bool {
        use std::io::Write;
        let mut file = tempfile::NamedTempFile::new().ok();
        if let Some(mut f) = file {
            if f.write_all(code.as_bytes()).is_ok() {
                return Command::new("go")
                    .arg("build")
                    .arg("-o")
                    .arg("/dev/null")
                    .arg(f.path())
                    .stdout(Stdio::null())
                    .stderr(Stdio::null())
                    .status()
                    .map(|s| s.success())
                    .unwrap_or(false);
            }
        }
        false
    }

    /// Verificar formato
    async fn verify_format(&self, target: &Path) -> Result<VerificationResult> {
        let start = Instant::now();
        let mut passed = true;
        let mut details = String::new();

        if target.is_file() {
            let ext = target.extension().and_then(|e| e.to_str()).unwrap_or("");
            match ext {
                "py" => {
                    let output = Command::new("ruff")
                        .args(["format", "--check", target.to_str().unwrap()])
                        .output()?;
                    passed = output.status.success();
                    if !passed { details = String::from_utf8_lossy(&output.stderr).to_string(); }
                }
                "rs" => {
                    let output = Command::new("rustfmt")
                        .args(["--check", target.to_str().unwrap()])
                        .output()?;
                    passed = output.status.success();
                    if !passed { details = String::from_utf8_lossy(&output.stderr).to_string(); }
                }
                "js" | "ts" | "jsx" | "tsx" => {
                    let output = Command::new("prettier")
                        .args(["--check", target.to_str().unwrap()])
                        .output()?;
                    passed = output.status.success();
                    if !passed { details = String::from_utf8_lossy(&output.stderr).to_string(); }
                }
                _ => {}
            }
        }

        Ok(VerificationResult {
            level: VerificationLevel::Format,
            passed,
            score: if passed { 100.0 } else { 0.0 },
            details,
            duration_ms: start.elapsed().as_millis() as u64,
            artifacts: Vec::new(),
        })
    }

    /// Verificar lint
    async fn verify_lint(&self, target: &Path) -> Result<VerificationResult> {
        let start = Instant::now();
        let mut passed = true;
        let mut details = String::new();

        if target.is_file() {
            let ext = target.extension().and_then(|e| e.to_str()).unwrap_or("");
            match ext {
                "py" => {
                    let output = Command::new("ruff")
                        .args(["check", target.to_str().unwrap()])
                        .output()?;
                    passed = output.status.success();
                    if !passed { details = String::from_utf8_lossy(&output.stdout).to_string(); }
                }
                "rs" => {
                    let output = Command::new("cargo")
                        .args(["clippy", "--", "-D", "warnings"])
                        .current_dir(self.workspace_root.join(target).parent().unwrap_or(&self.workspace_root))
                        .output()?;
                    passed = output.status.success();
                    if !passed { details = String::from_utf8_lossy(&output.stderr).to_string(); }
                }
                "js" | "ts" | "jsx" | "tsx" => {
                    let output = Command::new("eslint")
                        .arg(target.to_str().unwrap())
                        .output()?;
                    passed = output.status.success();
                    if !passed { details = String::from_utf8_lossy(&output.stdout).to_string(); }
                }
                _ => {}
            }
        }

        Ok(VerificationResult {
            level: VerificationLevel::Lint,
            passed,
            score: if passed { 100.0 } else { 50.0 },
            details,
            duration_ms: start.elapsed().as_millis() as u64,
            artifacts: Vec::new(),
        })
    }

    /// Verificar tipos
    async fn verify_types(&self, target: &Path) -> Result<VerificationResult> {
        let start = Instant::now();
        let mut passed = true;
        let mut details = String::new();

        if target.is_file() {
            let ext = target.extension().and_then(|e| e.to_str()).unwrap_or("");
            match ext {
                "py" => {
                    let output = Command::new("mypy")
                        .args(["--strict", target.to_str().unwrap()])
                        .output()?;
                    passed = output.status.success();
                    if !passed { details = String::from_utf8_lossy(&output.stdout).to_string(); }
                }
                "rs" => {
                    let output = Command::new("cargo")
                        .args(["check"])
                        .current_dir(self.workspace_root.join(target).parent().unwrap_or(&self.workspace_root))
                        .output()?;
                    passed = output.status.success();
                    if !passed { details = String::from_utf8_lossy(&output.stderr).to_string(); }
                }
                "ts" | "tsx" => {
                    let output = Command::new("tsc")
                        .args(["--noEmit", target.to_str().unwrap()])
                        .output()?;
                    passed = output.status.success();
                    if !passed { details = String::from_utf8_lossy(&output.stdout).to_string(); }
                }
                _ => {}
            }
        }

        Ok(VerificationResult {
            level: VerificationLevel::Types,
            passed,
            score: if passed { 100.0 } else { 50.0 },
            details,
            duration_ms: start.elapsed().as_millis() as u64,
            artifacts: Vec::new(),
        })
    }

    /// Verificar tests unitarios
    async fn verify_unit_tests(&self, target: &Path) -> Result<VerificationResult> {
        let start = Instant::now();
        let mut passed = true;
        let mut details = String::new();
        let mut artifacts = Vec::new();

        if target.is_file() {
            let ext = target.extension().and_then(|e| e.to_str()).unwrap_or("");
            match ext {
                "py" => {
                    let output = Command::new("python3")
                        .args(["-m", "pytest", target.to_str().unwrap(), "-v", "--tb=short"])
                        .output()?;
                    passed = output.status.success();
                    if !passed { details = String::from_utf8_lossy(&output.stdout).to_string(); }
                    artifacts.push("pytest_output.txt".to_string());
                }
                "rs" => {
                    let output = Command::new("cargo")
                        .args(["test", "--", "--test-threads=4"])
                        .current_dir(self.workspace_root.join(target).parent().unwrap_or(&self.workspace_root))
                        .output()?;
                    passed = output.status.success();
                    if !passed { details = String::from_utf8_lossy(&output.stdout).to_string(); }
                }
                "js" | "ts" | "jsx" | "tsx" => {
                    let output = Command::new("npm")
                        .args(["test", "--", target.to_str().unwrap()])
                        .output()?;
                    passed = output.status.success();
                    if !passed { details = String::from_utf8_lossy(&output.stdout).to_string(); }
                }
                _ => {}
            }
        } else {
            // Ejecutar todos los tests del proyecto
            let output = Command::new("python3")
                .args(["-m", "pytest", target.to_str().unwrap(), "-v"])
                .output()?;
            passed = output.status.success();
            if !passed { details = String::from_utf8_lossy(&output.stdout).to_string(); }
        }

        Ok(VerificationResult {
            level: VerificationLevel::UnitTests,
            passed,
            score: if passed { 100.0 } else { 0.0 },
            details,
            duration_ms: start.elapsed().as_millis() as u64,
            artifacts,
        })
    }

    /// Verificar tests de integración
    async fn verify_integration_tests(&self, target: &Path) -> Result<VerificationResult> {
        let start = Instant::now();
        let mut passed = true;
        let mut details = String::new();

        // Buscar y ejecutar tests de integración
        let output = Command::new("python3")
            .args(["-m", "pytest", target.to_str().unwrap(), "-k", "integration", "-v"])
            .output()?;
        
        passed = output.status.success();
        if !passed { details = String::from_utf8_lossy(&output.stdout).to_string(); }

        Ok(VerificationResult {
            level: VerificationLevel::IntegrationTests,
            passed,
            score: if passed { 100.0 } else { 0.0 },
            details,
            duration_ms: start.elapsed().as_millis() as u64,
            artifacts: Vec::new(),
        })
    }

    /// Verificar seguridad
    async fn verify_security(&self, target: &Path) -> Result<VerificationResult> {
        let start = Instant::now();
        let mut passed = true;
        let mut details = String::new();
        let mut artifacts = Vec::new();

        // Bandit para Python
        if target.is_dir() || target.extension().map_or(false, |e| e == "py") {
            let output = Command::new("bandit")
                .args(["-r", target.to_str().unwrap(), "-f", "json"])
                .output()?;
            
            if !output.status.success() {
                passed = false;
                details = String::from_utf8_lossy(&output.stdout).to_string();
            }
            artifacts.push("bandit_report.json".to_string());
        }

        // Cargo audit para Rust
        if target.is_dir() || target.extension().map_or(false, |e| e == "rs") {
            let output = Command::new("cargo")
                .args(["audit", "--json"])
                .current_dir(&self.workspace_root)
                .output()?;
            
            if !output.status.success() {
                passed = false;
                details = String::from_utf8_lossy(&output.stdout).to_string();
            }
            artifacts.push("cargo_audit.json".to_string());
        }

        Ok(VerificationResult {
            level: VerificationLevel::Security,
            passed,
            score: if passed { 100.0 } else { 0.0 },
            details,
            duration_ms: start.elapsed().as_millis() as u64,
            artifacts,
        })
    }

    /// Verificar rendimiento (básico)
    async fn verify_performance(&self, target: &Path) -> Result<VerificationResult> {
        let start = Instant::now();
        let mut passed = true;
        let mut details = String::new();

        for entry in walkdir::WalkDir::new(target).into_iter().filter_map(|e| e.ok()) {
            let path = entry.path();
            if path.is_file() {
                let metadata = std::fs::metadata(path)?;
                if metadata.len() > 1_000_000 { // > 1MB
                    passed = false;
                    details.push_str(&format!("Large file: {} ({} bytes)\n", path.display(), metadata.len()));
                }
            }
        }

        Ok(VerificationResult {
            level: VerificationLevel::Performance,
            passed,
            score: if passed { 100.0 } else { 80.0 },
            details,
            duration_ms: start.elapsed().as_millis() as u64,
            artifacts: Vec::new(),
        })
    }

    /// Comparar con baseline
    fn compare_with_baseline(&self, baseline: &VerificationReport, current: &VerificationReport) -> BaselineComparison {
        let mut improvements = Vec::new();
        let mut regressions = Vec::new();

        for (baseline_res, current_res) in baseline.results.iter().zip(current.results.iter()) {
            if baseline_res.level == current_res.level {
                let diff = current_res.score - baseline_res.score;
                if diff > 5.0 {
                    improvements.push(format!("{}: +{:.1}", baseline_res.level.name(), diff));
                } else if diff < -5.0 {
                    regressions.push(format!("{}: {:.1}", baseline_res.level.name(), diff));
                }
            }
        }

        BaselineComparison {
            previous_score: baseline.overall_score,
            current_score: current.overall_score,
            regression: current.overall_score < baseline.overall_score - 5.0,
            improvements,
            regressions,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use tempfile::TempDir;

    #[tokio::test]
    async fn test_verification_engine_basic() {
        let temp_dir = TempDir::new().unwrap();
        let test_file = temp_dir.path().join("test.py");
        std::fs::write(&test_file, "def hello():\n    return 'hello'\n").unwrap();

        let config = VerificationConfig::default();
        let engine = VerificationEngine::new(temp_dir.path().to_path_buf(), config).unwrap();

        let report = engine.verify(temp_dir.path().join("test.py")).await.unwrap();
        assert!(report.overall_passed);
        assert!(report.overall_score > 80.0);
    }
}